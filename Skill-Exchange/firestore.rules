rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    match /profiles/{profileId} {
      allow read, write: if signedIn();
    }

    match /needs/{needId} {
      allow read, write: if signedIn();
    }

    match /offers/{offerId} {
      allow read, write: if signedIn();
    }

    match /negotiations/{offerId}/messages/{messageId} {
      allow read, write: if signedIn();
    }
  }
}
