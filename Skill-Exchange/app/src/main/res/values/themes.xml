<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.SkillExchange" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/forest</item>
        <item name="colorPrimaryVariant">@color/seed_green</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/sun</item>
        <item name="colorOnSecondary">@color/ink</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/forest</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:windowBackground">@color/surface</item>
        <item name="materialButtonStyle">@style/Widget.SkillExchange.Button</item>
        <item name="textInputStyle">@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
    </style>

    <style name="Widget.SkillExchange.Button" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">16dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="iconTint">@color/white</item>
    </style>
</resources>
